# Prep stage: read combined membrane+polymer data file, add LJ solvent atoms
# inside and outside the vesicle, run a short minimization, and write a
# complete data file for the GPU benchmark. Run on CPU with multi-MPI
# (no -sf kk / no -k flags).
#
# Required variables:
#   combined_file  path to pre-combined membrane+polymer data file
#   N_in           number of solvent atoms inside vesicle
#   N_out          number of solvent atoms outside vesicle
#   radius         vesicle radius (for region definition)
#   out_file       full output path for the prepared data file

units      lj
atom_style dipole_sphere_angle
neighbor   1.0 bin
neigh_modify delay 0 every 1 check yes binsize 2.5
boundary   p p p

# extra/atom/types 1: the combined file has 2 types; we add type 3 (solvent)
read_data ${combined_file} extra/atom/types 1

# Add solvent atoms (type 3) inside and outside the vesicle sphere
region out_vesicle sphere 0.0 0.0 0.0 ${radius} side out
region in_vesicle  sphere 0.0 0.0 0.0 ${radius} side in
create_atoms 3 random ${N_out} 4323 out_vesicle overlap 0.8 maxtry 10
# create_atoms 3 random ${N_in}  4324 in_vesicle  overlap 1.0 maxtry 50

# Set solvent properties: sigma=1 -> diameter=1, mass from density*volume
set type 3 diameter 1.0
variable wat_volume  equal (4.0/3.0)*PI*(0.5)^3
variable wat_density equal 1.0/${wat_volume}
set type 3 density ${wat_density}
set type 3 dipole 0.0 0.0 1.0

# Pair styles (must match polymer_solvent.lmp)
pair_style hybrid membrane_sillanov2 2.5 lj/cut 1.12246152962189
pair_coeff 1 1 membrane_sillanov2 1.0 1.0 15.0 1.0 2.5 2.0 5 0.0
pair_coeff 2 2 lj/cut 1.0 1.0 1.12246152962189
pair_coeff 3 3 lj/cut 1.0 1.0 1.12246152962189
pair_coeff 1 2 lj/cut 1.0 1.0 1.12246152962189
pair_coeff 1 3 lj/cut 1.0 1.0 1.12246152962189
pair_coeff 2 3 lj/cut 1.0 1.0 1.12246152962189

# Bond and angle styles must be declared to correctly read topology from data file
bond_style  fene
bond_coeff  1 30.0 1.5 1.0 1.0
special_bonds fene

angle_style cosine
angle_coeff 1 2.0

# Short minimization to relax near-overlaps from random solvent placement
thermo 100
thermo_style custom step pe fnorm
minimize 1.0e-4 1.0e-4 500 5000

write_data ${out_file} nocoeff
print "PREP_DONE: wrote ${out_file}"
