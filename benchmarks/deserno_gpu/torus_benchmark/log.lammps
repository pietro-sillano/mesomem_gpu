LAMMPS (22 Jul 2025 - Update 4)
KOKKOS mode with Kokkos version 4.6.2 is enabled
  will use up to 1 GPU(s) per node
  using 4 OpenMP thread(s) per MPI task
package kokkos
package kokkos newton off neigh full comm host
# mpirun -np 8 lmp_radial -i torus_edges.lmp -v R 5.0 -v h 20.0 -v kt 18
variable t_dump equal 100
# variable v_rcut string 2.5

units           lj
atom_style      full
neighbor        0.5 bin
neigh_modify    delay 0 every 1 check yes

dimension       3
boundary        p p p

# read torus with planes equilibrated
read_data       torus_R_8.0_h_20.0_eq.data
