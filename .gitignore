# build outputs produced by compile.sh (downloaded LAMMPS source, cmake
# build dir, installed binaries, python venv) - fully reproducible, never
# commit these
_build/

# the local development LAMMPS checkout (vanilla upstream + cpp_files/
# copied in) - reproduce with ./compile.sh, don't version a second copy
# of upstream LAMMPS here
/lammps/

# python
__pycache__/
*.pyc
*.egg-info/

# raw per-run LAMMPS working directories (regenerated by benchmark.py);
# results_*.csv and plots/ are the curated outputs, keep those
bench_runs/

# editor / OS cruft
.DS_Store
*.swp

# local Claude Code settings (machine-specific permission allowlist)
.claude/
