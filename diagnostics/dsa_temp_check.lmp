# Diagnostic: check CPU vs GPU temperatures for atom_style mesomem.
# Uses the small 8600-atom planar membrane (type 1 only, no polymer).
# Checks that temp/sphere on GPU now gives ~T_target after the omega_thermostat fix.

units lj
atom_style mesomem
boundary p p p
neighbor 1.0 bin
neigh_modify delay 0 every 1 check yes binsize 5

read_data /martini/pietro/mesomem_gpu/planar_benchmark_89/input/lattice_d_0.85_N_10000_ds

group membrane type 1

variable v_T  equal 0.2
variable v_dt equal 0.01

pair_style mesomem 2.5
pair_coeff 1 1 1.0 1.0 15.0 1.0 2.5 2.0 5 0.0

timestep ${v_dt}

# One temp/sphere compute is safe (avoids double-free under -sf kk)
compute Tmem_sp  membrane temp/sphere dof all
compute Tmem_tr  membrane temp
compute Tall_tr  all      temp

thermo_style custom step temp c_Tall_tr c_Tmem_tr c_Tmem_sp pe ke
thermo 500

fix fnve   membrane nve/sphere update dipole
fix fLang  membrane langevin ${v_T} ${v_T} 1.0 456 omega yes
fix_modify fLang temp Tmem_sp

run 3000
